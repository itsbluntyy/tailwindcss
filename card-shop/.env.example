# --- Local development ---
# SQLite file used by Prisma locally.
DATABASE_URL="file:./dev.db"

# Password for the /admin area. Pick something strong.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="change-me-too"

# Stripe secret key. Use the TEST key (sk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY="sk_test_..."

# Optional: only needed if you set up the Stripe webhook (recommended for production).
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Production (Vercel + Turso) ---
# When these two are set, the app talks to Turso (hosted SQLite) instead of the
# local file. Leave them unset for local development.
# TURSO_DATABASE_URL="libsql://your-db-name-yourname.turso.io"
# TURSO_AUTH_TOKEN="..."
